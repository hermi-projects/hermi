# Parameters for gen-agent-runtime.sh.
#
# These are the instance-level facts that AGENT_REQUIREMENTS.md §3 says the type model cannot
# decide and must be supplied from outside: which module is which, what a module may split
# into, and the sentences the generated agents carry. No scope is configured for the parent
# pom.xml, because no instance owns it. Everything else the generator needs it
# reads from pom.xml and the source tree -- which modules exist, and where their packages are.
#
# Adopting this generator for another project means rewriting this file and the three
# templates in scripts/agent/templates/. Nothing in the generator names a module, a package
# or a domain.
#
# It is sourced by the generator, so it is shell and quoting is real: a sentence wrapped in
# single quotes cannot contain an apostrophe (it ends the string, and the file stops parsing),
# and a backtick opens a command substitution unless the line is single-quoted.

# The modules that do not split into packages, as <module>:<note key>. Every other module in
# pom.xml is an Intent module. Any number of entries, or none: empty means every module is an
# Intent module. This repository lists the two roles of AGENT_REQUIREMENTS.md §7 -- the shared
# contract provider and the composition root.
NON_INTENT_MODULES="hermi-common:common hermi-main-app:mainapp"

# The packages a module may split into, in the order their agents are written. A module with no
# such package gets no agent for it; a module in NON_INTENT_MODULES is never asked.
PACKAGE_ROLES="usecase shell"

# One sentence per non-intent module, keyed note_<note key>. There is no note_intent: that
# paragraph is built from the packages the module actually has.
note_common='This is the shared module. It must not depend on any Intent module. Shared DTOs, exceptions and ports belong here and must not be copied into Intent modules.'
note_mainapp='You are the composition root.'

# One sentence per role in PACKAGE_ROLES, keyed note_<role>.
note_usecase='Keep `usecase` free of Spring imports and free of imports from another Intent package.'
note_shell='Spring wiring belongs in `shell`.'
